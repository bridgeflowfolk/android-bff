<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Réseau -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        SCHEDULE_EXACT_ALARM uniquement, limité à Android ≤ 12 (API 32).
        Android 13+ : WorkManager utilise des alarmes inexactes par défaut,
        ce qui est suffisant pour des rappels d'événements associatifs.

        USE_EXACT_ALARM est délibérément absent : réservé aux apps de réveil/chronomètre,
        son utilisation ici déclencherait un rejet Play Store (politique Google).
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Background -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        FOREGROUND_SERVICE_DATA_SYNC requis depuis Android 14 (API 34).
        Sans le type explicite, le système lève une SecurityException si un
        Worker passe en foreground. On déclare les deux pour la compatibilité.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Queries pour résolution d'intent (navigation, partage) -->
    <queries>
        <!-- Waze -->
        <package android:name="com.waze" />
        <!-- Google Maps -->
        <package android:name="com.google.android.apps.maps" />
        <!-- Apps mail génériques -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- Apps navigation waze:// -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="waze" />
        </intent>
        <!-- Apps navigation geo:// -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".BffApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.BFF"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Désactive l'auto-init WorkManager pour laisser Hilt injecter la factory -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            BootReceiver sans android:permission pour maximiser la compatibilité.

            Pourquoi on retire android:permission="RECEIVE_BOOT_COMPLETED" :
            Cette protection empêche le système de certains constructeurs (Xiaomi MIUI,
            HTC Sense, Samsung One UI en mode strict) de déclencher le receiver via
            leur propre séquence de démarrage, qui n'envoie pas toujours l'intent avec
            les permissions attendues.

            La protection suffisante est assurée par android:exported="true" + le filtre
            d'intent : seul le système émet BOOT_COMPLETED et QUICKBOOT_POWERON en pratique.
            Un app tierce ne peut pas les forger sans permission système.

            Note pour les tests ADB :
              adb shell am broadcast -a android.intent.action.BOOT_COMPLETED \
                -p com.bridgeflowfolk.bff
            fonctionne uniquement sur un appareil rooté ou un émulateur.
        -->
        <receiver
            android:name=".workers.BootReceiver"
            android:exported="true">
            <intent-filter>
                <!-- Boot standard (tous constructeurs) -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!--
                    Boot rapide Xiaomi / HTC : ces constructeurs n'émettent pas
                    toujours BOOT_COMPLETED lors d'un redémarrage à chaud.
                    QUICKBOOT_POWERON garantit la replanification des workers.
                -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- Variante HTC Sense (package différent de Xiaomi) -->
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
