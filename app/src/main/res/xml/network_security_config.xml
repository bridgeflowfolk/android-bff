<?xml version="1.0" encoding="utf-8"?>
<!--
    Politique réseau stricte : HTTPS uniquement.
    GitHub Pages et wa.me utilisent HTTPS natif.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
